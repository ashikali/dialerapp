[Unit]
Description=PBXPro Laravel Queue Worker
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/pbxpro/backend
ExecStart=/usr/bin/php artisan queue:work redis --sleep=1 --tries=3 --timeout=120 --max-time=3600
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=360
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
