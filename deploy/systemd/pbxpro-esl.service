[Unit]
Description=PBXPro FreeSWITCH ESL Worker
After=network.target freeswitch.service redis-server.service postgresql.service
Requires=redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/pbxpro/backend
ExecStart=/usr/bin/php artisan telephony:esl
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
