APP_NAME=PBXPro
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pbxpro.test
FRONTEND_URL=https://pbxpro.test
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pbxpro
DB_USERNAME=pbxpro
DB_PASSWORD=change-this-database-password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=pbxpro.test
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=pbxpro.test

# Used only when php artisan db:seed creates the initial Super Admin.
# Replace the password before seeding, log in once, then remove the password
# from the deployed .env file. Do not commit a real password here.
PBXPRO_ADMIN_EMAIL=admin@pbxpro.test
PBXPRO_ADMIN_PASSWORD=change-this-long-initial-admin-password

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REVERB_APP_ID=pbxpro
REVERB_APP_KEY=change-this-reverb-key
REVERB_APP_SECRET=change-this-reverb-secret
REVERB_HOST=pbxpro.test
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

FREESWITCH_ESL_HOST=127.0.0.1
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=change-this-esl-password
FREESWITCH_XML_TOKEN=change-this-long-random-token
FREESWITCH_RECORDING_ROOT=/var/lib/freeswitch/recordings

VITE_APP_NAME=PBXPro
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
